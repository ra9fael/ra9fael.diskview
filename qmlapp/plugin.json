{
  "$schema": "https://raw.githubusercontent.com/LingCore/WinShun-plugins/main/schema/plugin.schema.json",
  "manifest": 1,
  "id": "ra9fael.diskview.qml",
  "name": {"zh": "磁盘透视 · QML", "en": "Disk View · QML"},
  "version": "0.1.16",
  "description": "QML 版磁盘占用可视化：自由 Dock 与 Tab 停靠、方块/圆盘图、独立文件列表、扩展名过滤与进程内 MFT 快扫。暂用本地设置，不同步宿主外观和扫描设置。",
  "author": "ra9fael",
  "license": "MIT",
  "icon": "app.ico",
  "permissions": ["ui", "files:read", "clipboard:write", "processes", "elevated"],
  "runtime": {
    "mode": "resident",
    "program": "diskview-qml.exe",
    "qt": "host",
    "qtVersion": "6.12.0",
    "sandbox": "normal",
    "start": "lazy",
    "timeoutMs": 3000,
    "memoryMB": 2048,
    "idleExitSec": 0,
    "encoding": "utf-8"
  },
  "settings": [
    {
      "key": "defaultView",
      "type": "choice",
      "title": {"zh": "默认视图", "en": "Default view"},
      "hint": {"zh": "打开窗口时先用哪种画法；窗口里随时可切", "en": "Which layout to open with; switchable in the window"},
      "default": "treemap",
      "options": ["treemap", "sunburst"]
    },
    {
      "key": "scanMode",
      "type": "choice",
      "title": {"zh": "扫描方式", "en": "Scan mode"},
      "hint": {"zh": "自动：能用 MFT 快扫就用，不能就普通遍历。快扫需要管理员权限，WinShun 未以管理员运行时自动跳过。",
               "en": "Automatic uses the NTFS fast scan when it can; the fast scan needs administrator rights and is skipped when WinShun is not elevated."},
      "default": "auto",
      "options": ["auto", "fast", "ordinary"]
    },
    {
      "key": "workers",
      "type": "choice",
      "title": {"zh": "普通扫描并发上限", "en": "Ordinary scan workers"},
      "hint": {"zh": "自动时由扫描器按介质决定；并发更高不保证更快", "en": "Automatic lets the scanner decide; more workers are not promised to be faster"},
      "default": "auto",
      "options": ["auto", "1", "2", "4", "8"]
    },
    {
      "key": "media",
      "type": "choice",
      "title": {"zh": "介质策略", "en": "Media"},
      "hint": {"zh": "告诉扫描器盘是什么类型，影响并发与预读", "en": "Lets the scanner tune concurrency and read-ahead"},
      "default": "auto",
      "options": ["auto", "ssd", "hdd", "network"]
    },
    {
      "key": "preview",
      "type": "choice",
      "title": {"zh": "预览发布", "en": "Preview rate"},
      "hint": {"zh": "扫描过程中界面刷新的间隔", "en": "How often the window refreshes during a scan"},
      "default": "balanced",
      "options": ["balanced", "less"]
    }
  ],
  "commands": [
    {
      "id": "disk",
      "keyword": "disk",
      "title": {"zh": "磁盘占用分析 · QML", "en": "Disk space analyzer · QML"},
      "hint": {"zh": "Enter 打开窗口 · 可带路径，如 disk D:\\工作",
               "en": "Enter opens the window · optional path, e.g. disk D:\\work"},
      "actions": [
        {"id": "open", "title": {"zh": "打开磁盘透视窗口", "en": "Open disk view"}, "key": "Enter"}
      ]
    }
  ]
}
