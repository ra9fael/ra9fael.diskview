{
  "$schema": "https://raw.githubusercontent.com/LingCore/WinShun-plugins/main/schema/plugin.schema.json",
  "manifest": 1,
  "id": "ra9fael.diskview.qml",
  "name": {"zh": "磁盘透视 · QML", "en": "Disk View · QML"},
  "version": "0.3.16",
  "description": "QML 版磁盘占用可视化：跟随 WinShun 主题、切换磁盘下拉框、独立文件视图筛选、可调列宽与安全文件操作。",
  "author": "ra9fael",
  "license": "MIT",
  "icon": "app.ico",
  "permissions": ["ui", "files:read", "files:write", "clipboard:write", "processes", "elevated"],
  "runtime": {
    "mode": "resident",
    "program": "diskview-qml.exe",
    "qt": "host",
    "qtVersion": "6.12.0",
    "sandbox": "normal",
    "start": "lazy",
    "timeoutMs": 3000,
    "memoryMB": 2048,
    "idleExitSec": 0,
    "encoding": "utf-8"
  },
  "settingsWindow": true,
  "settings": [
    {
      "key": "defaultView",
      "type": "choice",
      "title": {"zh": "默认视图", "en": "Default view"},
      "hint": {"zh": "新窗口先用哪种画法；窗口里切换视图不会改这里", "en": "Which layout a new window opens with; switching it in the window does not change this"},
      "default": "treemap",
      "options": ["treemap", "sunburst"]
    },
    {
      "key": "scanMode",
      "type": "choice",
      "title": {"zh": "扫描方式", "en": "Scan mode"},
      "hint": {"zh": "自动：能用 MFT 快扫就用，不能就普通遍历。快扫需要管理员权限，WinShun 未以管理员运行时自动跳过。",
               "en": "Automatic uses the NTFS fast scan when it can; the fast scan needs administrator rights and is skipped when WinShun is not elevated."},
      "default": "auto",
      "options": ["auto", "fast", "ordinary"]
    },
    {
      "key": "folderMenuEnabled",
      "type": "bool",
      "title": {"zh": "文件夹右键菜单", "en": "Folder menu entry"},
      "hint": {"zh": "在文件夹结果上提供「分析文件夹占用」", "en": "Offers \"analyze this folder\" on a folder result"},
      "default": true
    }
  ],
  "commands": [
    {
      "id": "disk",
      "keyword": "disk",
      "title": {"zh": "磁盘占用分析 · QML", "en": "Disk space analyzer · QML"},
      "hint": {"zh": "Enter 打开窗口 · 可带路径，如 disk D:\\工作",
               "en": "Enter opens the window · optional path, e.g. disk D:\\work"},
      "actions": [
        {"id": "open", "title": {"zh": "打开磁盘透视窗口", "en": "Open disk view"}, "key": "Enter"}
      ],
      "triggers": [
        {
          "files": {
            "kind": "folder",
            "max": 1,
            "if": "folderMenuEnabled",
            "title": {"zh": "分析文件夹占用", "en": "Analyze folder space"}
          }
        }
      ]
    }
  ]
}
