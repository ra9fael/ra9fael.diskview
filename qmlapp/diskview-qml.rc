#pragma code_page(65001)
#include <winver.h>

// The same icon the native (GDI) edition embeds: the QML launcher had only the
// window icon from the resource, so the taskbar and Alt-Tab showed the generic
// executable icon.
IDI_ICON1 ICON "../app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,16,0
 PRODUCTVERSION 0,1,16,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "磁盘透视 · Win顺 插件 (QML)"
            VALUE "FileVersion", "0.1.16"
            VALUE "InternalName", "diskview-qml"
            VALUE "OriginalFilename", "diskview-qml.exe"
            VALUE "ProductName", "Win顺 · WinShun"
            VALUE "ProductVersion", "0.1.16"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
